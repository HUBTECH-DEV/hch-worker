<Project>
  <PropertyGroup>
    <Version>4.0.0</Version>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <Authors>HUBTECH-DEV</Authors>
    <Company>HubTech</Company>
    <Product>HCH Worker</Product>
    <Copyright>Copyright © HubTech 2026</Copyright>
    <RepositoryUrl>https://github.com/HUBTECH-DEV/hch-worker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(HchLinuxBuild)' == 'true'">$(MSBuildProjectDirectory)/packages.linux.lock.json</NuGetLockFilePath>
    <!-- Os lockfiles Linux foram gerados com o identificador de runtime
         linux-x64 e registram os alvos net10.0 e net10.0/linux-x64. Sem
         declarar o mesmo identificador aqui, o restore em modo travado falha
         com NU1004: o projeto avalia sem identificador algum e diverge do lock. -->
    <RuntimeIdentifiers Condition="'$(HchLinuxBuild)' == 'true'">linux-x64</RuntimeIdentifiers>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
