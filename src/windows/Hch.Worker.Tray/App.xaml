<Application x:Class="Hch.Worker.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hch.Worker.Tray"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BrandBrush" Color="#155EEF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DFEA" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5D6B82" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#138A52" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45F06" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Application.Resources>
</Application>
