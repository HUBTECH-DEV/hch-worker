<Window x:Class="Hch.Worker.Tray.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar HCH Worker 4.0" Width="860" Height="690" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Continue"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Assistente de configuração inicial do HCH Worker 4.0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,18">
            <StackPanel>
                <TextBlock Text="Configurar o HCH Worker 4.0" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="O Worker permanecerá em Paused/Drain até você concluir e escolher Start." Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="StepProgressText" Text="Etapa 1 de 5 · Serviço" Margin="0,5,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="5" Margin="18,14,18,6">
            <TextBlock Text="1  Serviço" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="2  Conta" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="3  Chave" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="4  Enrollment" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="5  Validação" FontWeight="SemiBold" TextAlignment="Center" />
        </UniformGrid>

        <TabControl x:Name="Steps" Grid.Row="2" SelectedIndex="0" Background="Transparent" BorderThickness="0" Margin="18,4">
            <TabControl.Resources>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
            </TabControl.Resources>

            <TabItem>
                <StackPanel Margin="12">
                    <TextBlock Text="Verificação do serviço e da conexão" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="O serviço Windows é verificado separadamente do estado operacional. Nenhum claim será iniciado durante esta configuração." TextWrapping="Wrap" Margin="0,7,0,18" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource MetricCard}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Serviço Windows" FontWeight="SemiBold" /><TextBlock x:Name="ServiceStatus" Grid.Column="1" Text="Verificando…" />
                            <TextBlock Grid.Row="1" Text="Orquestrador" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="ConnectionStatus" Grid.Row="1" Grid.Column="1" Text="Verificando…" Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2" Text="Estado operacional" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="OperationalStatus" Grid.Row="2" Grid.Column="1" Text="Paused/Drain" Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                    <Button Content="_Verificar novamente" HorizontalAlignment="Left" Click="VerifyService_Click"
                            AutomationProperties.Name="Verificar serviço novamente" />
                </StackPanel>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Conta HubTech/HIH" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Use uma conta com acesso ao Tenant HubTech e permissão no HCH. O navegador com PKCE é a opção recomendada." TextWrapping="Wrap" Margin="0,7,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Content="_Entrar com o HIH (recomendado)" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BrowserLogin_Click" AutomationProperties.Name="Entrar com o HIH usando o navegador do sistema" />
                        <Separator Margin="0,15" />
                        <TextBlock Text="Alternativa nativa" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="A senha é enviada somente ao HIH por TLS e nunca passa pelo serviço Windows ou pelo orquestrador." TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Grid MaxWidth="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="EmailLabel" Text="E-mail" VerticalAlignment="Center" /><TextBox x:Name="EmailInput" Grid.Column="1" MinHeight="36" Margin="4" AutomationProperties.Name="E-mail da conta HIH" AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" />
                            <TextBlock x:Name="PasswordLabel" Grid.Row="1" Text="Senha" VerticalAlignment="Center" />
                            <Grid Grid.Row="1" Grid.Column="1">
                                <PasswordBox x:Name="PasswordInput" MinHeight="36" Margin="4" AutomationProperties.Name="Senha da conta HIH" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                                <TextBox x:Name="VisiblePasswordInput" MinHeight="36" Margin="4" Visibility="Collapsed" AutomationProperties.Name="Senha da conta HIH visível" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
                            </Grid>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="116,2,0,0">
                            <CheckBox x:Name="ShowPassword" Content="_Mostrar senha" VerticalAlignment="Center" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
                            <Button Content="E_ntrar" Click="NativeLogin_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="116,4,0,0">
                            <Button Content="Esqueci minha _senha" Click="ForgotPassword_Click" />
                            <Button Content="Solicitar _acesso ao HCH" Click="CreateAccount_Click" />
                        </StackPanel>
                        <TextBlock x:Name="AccountStatus" Text="Nenhuma sessão iniciada." Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Chave SSH Ed25519 do usuário" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Esta chave pertence ao usuário e é independente da identidade operacional protegida do Worker. Arquivos existentes nunca serão sobrescritos." TextWrapping="Wrap" Margin="0,7,0,15" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="_Gerar no local recomendado" Style="{StaticResource PrimaryButton}" Click="GenerateRecommendedKey_Click" />
                            <Button Content="Escolher _outro local" Click="GenerateCustomKey_Click" />
                            <Button Content="_Usar chave Ed25519 existente" Click="UseExistingKey_Click" />
                        </StackPanel>
                        <Border Style="{StaticResource MetricCard}" Margin="4,16,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Algoritmo" FontWeight="SemiBold" /><TextBlock x:Name="KeyAlgorithm" Grid.Column="1" Text="Não configurado" />
                                <TextBlock Grid.Row="1" Text="Caminho" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBox x:Name="KeyPath" Grid.Row="1" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="Fingerprint" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBox x:Name="KeyFingerprint" Grid.Row="2" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,7,0,0" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Chave pública" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBox x:Name="PublicKey" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock Text="A chave privada nunca é exibida, copiada, transmitida, registrada em log ou incluída em telemetria." TextWrapping="Wrap" Margin="4,8" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <StackPanel Margin="12">
                    <TextBlock Text="Registro e enrollment" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="O HIH registra apenas a chave pública, fingerprint e vínculo do usuário. O HCH verifica uma prova de posse por nonce antes de vincular a identidade operacional do Worker." TextWrapping="Wrap" Margin="0,7,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Sessão HIH" FontWeight="SemiBold" /><TextBlock x:Name="EnrollmentAccountStatus" Text="Pendente" />
                            <TextBlock Text="Chave pública" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="EnrollmentKeyStatus" Text="Pendente" />
                            <TextBlock Text="Solicitação" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="EnrollmentRequestStatus" Text="Pendente" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="_Registrar chave pública no HIH" Style="{StaticResource PrimaryButton}" Click="Enroll_Click" />
                        <Button Content="_Autorizar e concluir enrollment" Click="CompleteEnrollment_Click" />
                    </StackPanel>
                    <TextBlock Text="O HCH revalida sua sessão e a chave pública diretamente no HIH, emite um token curto de uso único para este computador e o transfere de forma efêmera ao serviço. Você não precisa copiar nem visualizar o token." TextWrapping="Wrap" Margin="4,14,4,7" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </TabItem>

            <TabItem>
                <StackPanel Margin="12">
                    <TextBlock Text="Validação e conclusão" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="O Worker continua pausado. Valide identidade, trust, manifesto e readiness antes de habilitar claims com Start." TextWrapping="Wrap" Margin="0,7,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock Text="Enrollment" FontWeight="SemiBold" /><TextBlock x:Name="FinalEnrollmentStatus" Text="Pendente" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Identidade e trust" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="FinalTrustStatus" Text="Pendente" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Manifesto" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="FinalManifestStatus" Text="Pendente" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Readiness" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock x:Name="FinalReadyStatus" Text="Pendente" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Button Content="_Validar novamente" HorizontalAlignment="Left" Click="ValidateFinal_Click" />
                    <TextBlock Text="Concluir não inicia processamento. Use Start na Central de Controle quando estiver pronto." FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,14" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="WizardStatus" Text="Inicializando…" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="_Voltar" Click="Back_Click" IsEnabled="False" />
                    <Button x:Name="NextButton" Content="_Avançar" Style="{StaticResource PrimaryButton}" Click="Next_Click" />
                    <Button x:Name="FinishButton" Content="_Concluir" Style="{StaticResource PrimaryButton}"
                            Click="Finish_Click" Visibility="Collapsed" IsEnabled="False"
                            AutomationProperties.HelpText="Disponível somente após enrollment, trust e readiness válidos" />
                    <Button Content="_Cancelar" Click="Cancel_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
