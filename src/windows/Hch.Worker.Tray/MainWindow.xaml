<Window x:Class="Hch.Worker.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HCH Worker — Central de Controle"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AutomationProperties.Name="Central de Controle do HCH Worker">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource BrandBrush}">
                        <TextBlock Text="H" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WorkerTitle}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="  •  " Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Start" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryButton}" Click="Start_Click" AutomationProperties.Name="Iniciar novos trabalhos" />
                    <Button Content="Pause" IsEnabled="{Binding CanPause}" Click="Pause_Click" AutomationProperties.Name="Pausar novos trabalhos sem cancelar os atuais" />
                    <Button Content="Stop" IsEnabled="{Binding CanStop}" Foreground="{DynamicResource DangerBrush}" Click="Stop_Click" AutomationProperties.Name="Parar e cancelar os trabalhos atuais" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#0F1B33" Padding="10,16">
                <ListBox x:Name="Navigation" SelectedIndex="0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14"
                         AutomationProperties.Name="Seções da Central de Controle">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="Visão geral" />
                    <ListBoxItem Content="Trabalhos" />
                    <ListBoxItem Content="Desempenho" />
                    <ListBoxItem Content="Conexão" />
                    <ListBoxItem Content="Identidade" />
                    <ListBoxItem Content="Logs" />
                    <ListBoxItem Content="Atualizações" />
                    <ListBoxItem Content="Preferências" />
                </ListBox>
            </Border>

            <TabControl x:Name="Pages" Grid.Column="1" SelectedIndex="{Binding ElementName=Navigation, Path=SelectedIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Visão geral" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Operação diária, capacidade e saúde do Worker." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" />
                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU do Worker" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding WorkerCpuText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Memória atual" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding MemoryText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding GpuText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Rede" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding NetworkText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                            </UniformGrid>
                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Trabalhos ativos" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding CapacityText}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="{Binding CapacityDetail}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Fila central" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding QueueText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Concluídos" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding CompletedText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Falhas / retry" Foreground="{DynamicResource SecondaryTextBrush}" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FailedText}" FontSize="21" FontWeight="SemiBold" /><TextBlock Text="  /  " /><TextBlock Text="{Binding RetryText}" FontSize="21" FontWeight="SemiBold" /></StackPanel></StackPanel></Border>
                            </UniformGrid>

                            <Border Style="{StaticResource MetricCard}" Margin="5,12,5,5">
                                <StackPanel>
                                    <TextBlock Text="Lote atual" FontSize="17" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ActiveWork}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,4">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding AssignmentId}" FontWeight="SemiBold" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemPercentText}" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding ItemPercent}" Margin="0,6,0,3" AutomationProperties.Name="Progresso estimado do item atual" />
                                                        <DockPanel Margin="0,8,0,0">
                                                            <TextBlock Text="Itens do lote em processamento" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BatchText}" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <ProgressBar Height="9" Minimum="0" Maximum="100" Value="{Binding BatchPercent}" Margin="0,4,0,0" AutomationProperties.Name="Quantidade de itens processados no lote" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Nenhum item ativo." Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ActiveWork.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Saúde" FontWeight="SemiBold" /><TextBlock Text="{Binding TrustText}" /><TextBlock Text="{Binding ManifestText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Orquestrador" FontWeight="SemiBold" /><TextBlock Text="{Binding HeartbeatText}" /><TextBlock Text="{Binding LatencyText}" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Atualização" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" /></StackPanel></Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="20">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="Trabalhos" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Progresso e estado dos trabalhos ativos." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" /></StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveWork}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Assignment" Binding="{Binding AssignmentId}" Width="2*" />
                                <DataGridTextColumn Header="Etapa" Binding="{Binding Phase}" Width="*" />
                                <DataGridTextColumn Header="Tentativa" Binding="{Binding Attempt}" Width="90" />
                                <DataGridTextColumn Header="Progresso" Binding="{Binding ItemPercentText}" Width="100" />
                                <DataGridTextColumn Header="Item/lote" Binding="{Binding BatchText}" Width="100" />
                                <DataGridTextColumn Header="Bytes" Binding="{Binding ContentBytes}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Desempenho" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Métricas indisponíveis são exibidas como Não disponível, nunca como zero." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" /><UniformGrid Columns="3"><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU Worker / sistema" /><TextBlock Text="{Binding WorkerCpuText}" FontSize="20" /><TextBlock Text="{Binding SystemCpuText}" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Memória atual / média / pico" /><TextBlock Text="{Binding MemoryText}" FontSize="20" /><TextBlock Text="{Binding AverageMemoryText}" /><TextBlock Text="{Binding PeakMemoryText}" /></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU / VRAM" /><TextBlock Text="{Binding GpuText}" FontSize="20" /><TextBlock Text="{Binding VramText}" /></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Disco" /><TextBlock Text="{Binding DiskText}" /></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Rede" /><TextBlock Text="{Binding NetworkText}" /></StackPanel></Border><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Uptime" /><TextBlock Text="{Binding UptimeText}" FontSize="20" /></StackPanel></Border></UniformGrid><Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="Processos e serviço" FontWeight="SemiBold" /><TextBlock Text="{Binding ServicesText}" /><TextBlock Text="{Binding ProcessesText}" /><TextBlock Text="{Binding JobsText}" /></StackPanel></Border></StackPanel></ScrollViewer>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="20"><TextBlock Text="Conexão" FontSize="24" FontWeight="SemiBold" /><Border Style="{StaticResource MetricCard}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Serviço Windows" FontWeight="SemiBold" /><TextBlock Text="{Binding ServiceText}" /><TextBlock Text="Último heartbeat" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding HeartbeatText}" /><TextBlock Text="Latência" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding LatencyText}" /><TextBlock Text="Ollama" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding OllamaText}" /></StackPanel></Border></StackPanel>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="20"><TextBlock Text="Identidade" FontSize="24" FontWeight="SemiBold" /><Border Style="{StaticResource MetricCard}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Estado de confiança" FontWeight="SemiBold" /><TextBlock Text="{Binding TrustText}" /><TextBlock Text="A chave privada do usuário e a identidade operacional do Worker nunca são exibidas nesta tela." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" /><Button Content="Abrir assistente de configuração" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Onboarding_Click" /></StackPanel></Border></StackPanel>
                </TabItem>

                <TabItem>
                    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Logs" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Logs sanitizados: sem senha, token, chave privada, lease ou conteúdo editorial." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,14" /></StackPanel><ListBox Grid.Row="1" x:Name="LogsList" /><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Atualizar" Click="Refresh_Click" /><Button Content="Copiar seleção" Click="CopyLog_Click" /><Button Content="Exportar diagnóstico" Click="ExportLog_Click" /></StackPanel></Grid>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="20"><TextBlock Text="Atualizações" FontSize="24" FontWeight="SemiBold" /><Border Style="{StaticResource MetricCard}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Versão instalada" FontWeight="SemiBold" /><TextBlock Text="{Binding VersionText}" /><TextBlock Text="Versão disponível" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Text="{Binding UpdateText}" /><TextBlock Text="Uma atualização compatível não interrompe trabalhos nem fecha claims. Só uma mudança que afete o contrato ou o resultado editorial exige bloqueio." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border></StackPanel>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="20"><TextBlock Text="Preferências" FontSize="24" FontWeight="SemiBold" /><Border Style="{StaticResource MetricCard}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Trabalhos paralelos (0–64)" VerticalAlignment="Center" /><TextBox x:Name="ParallelismInput" Grid.Column="1" Text="{Binding Snapshot.MaxConcurrentJobs, Mode=OneWay}" Margin="4" MinHeight="34" AutomationProperties.Name="Quantidade máxima de trabalhos paralelos" /><Button Grid.Column="2" Content="Aplicar" HorizontalAlignment="Left" Click="ApplyParallelism_Click" /><TextBlock Grid.Row="1" Text="Itens máximos por claim (1–64)" VerticalAlignment="Center" /><TextBox x:Name="BatchInput" Grid.Row="1" Grid.Column="1" Text="{Binding Snapshot.ClaimBatchSize, Mode=OneWay}" Margin="4" MinHeight="34" AutomationProperties.Name="Quantidade máxima solicitada por claim" /><Button Grid.Row="1" Grid.Column="2" Content="Aplicar" HorizontalAlignment="Left" Click="ApplyBatch_Click" /><TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="Paralelismo zero equivale a Pause: bloqueia novos claims e não cancela o que já está executando." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" /></Grid></Border></StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="Fechar esta janela não interrompe o serviço." VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
