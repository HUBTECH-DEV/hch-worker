<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Hch.Worker.Service</AssemblyName>
    <RootNamespace>Hch.Worker.Service</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <DefineConstants>$(DefineConstants);HCH_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.11]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hch.Worker.Linux\Hch.Worker.Linux.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.Core\Hch.Worker.Core.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.IPC.Contracts\Hch.Worker.IPC.Contracts.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.Ollama\Hch.Worker.Ollama.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.Persistence\Hch.Worker.Persistence.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.Protocol\Hch.Worker.Protocol.csproj" />
    <ProjectReference Include="..\..\windows\Hch.Worker.Security\Hch.Worker.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\windows\Hch.Worker.Service\*.cs"
             Exclude="..\..\windows\Hch.Worker.Service\Program.cs;..\..\windows\Hch.Worker.Service\WorkerControlServer.cs"
             Link="Service\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\windows\Hch.Worker.Service\appsettings.json"
             Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
