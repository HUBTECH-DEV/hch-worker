      "paragraphs": 1
    },
    "COURSE_ACCESS_SUMMARY": {
      "minimumCharacters": 240,
      "maximumCharacters": 500,
      "paragraphs": 1
    },
    "COMMUNITY_DIRECTORY_SUMMARY": {
      "minimumCharacters": 200,
      "maximumCharacters": 420,
      "paragraphs": 1
    },
    "DISTRIBUTION_DERIVATIVE": {
      "deriveOnlyFromApprovedCanonicalContent": true
    }
  },
  "adaptiveWorkPolicy": {
    "algorithmVersion": "hch-adaptive-work-v1",
    "processingWindowSeconds": 2700,
    "nearWindowRatio": 0.8,
    "firstProgressGraceSeconds": 900,
    "stallAfterSeconds": 600,
    "finalizationGraceSeconds": 180,
    "windowMode": "advisory",
    "minimumTierIgnoresWindow": true,
    "livenessBasis": "progress",
    "tiers": [
      {
        "id": "minimum",
        "rank": 0,
        "minimumUnit": true,
        "maxOutputTokens": 768,
        "editorialProfile": "EDITORIAL_MINIMUM"
      },
      {
        "id": "compact",
        "rank": 1,
        "minimumUnit": false,
        "maxOutputTokens": 1536,
        "editorialProfile": "EDITORIAL_COMPACT"
      },
      {
        "id": "full",
        "rank": 2,
        "minimumUnit": false,
        "maxOutputTokens": 2400,
        "editorialProfile": "EDITORIAL_LONG_FORM"
      }
    ]
  },
  "citationPolicy": {
    "inlineCitationsRequired": true,
    "sourceListRequired": true,
    "citationFormat": "stable-source-id",
    "sourceIdPattern": "^S[1-9][0-9]*$",
    "minimumCitationsPerSourcedParagraph": 1,
    "unsupportedExternalClaimsAllowed": 0,
    "comparisonsAndReviewsMinimumSources": 2,
    "singleSourceExceptionRequiresJustification": true
  },
  "quotationPolicy": {
    "maximumWordsPerDirectQuotation": 25,
    "maximumQuotationRatio": 0.05,
    "attributionRequired": true
  },
  "rightsPolicy": {
    "fullRepublicationRequiresRightsEvidence": true,
    "translationRequiresDerivativePermission": true,
    "unknownRightsDefault": [
      "factual-metadata",
      "original-summary",
      "justified-short-excerpt",
      "canonical-link"
    ],
    "mediaRightsEvaluatedSeparately": true
  },
  "ingestionPolicy": {
    "defaultModerationStatus": "review",
    "automaticPublication": false,
    "separateSourceExcerptFromEditorialSummary": true
  },
  "translationPolicy": {
    "provider": "vps-local",
    "host": "vmid5398",
    "endpointEnv": "HCH_VPS_TRANSLATOR_URL",
    "tokenEnv": "HCH_VPS_TRANSLATOR_TOKEN",
    "externalFallbacks": [],
    "browserFallback": null,
    "onUnavailable": "preserve-source-language",
    "scope": "public-content-only"
  },
  "traceability": {
    "sourceRevisionRequired": true,
    "policyVersionRequired": true,
    "promptConfigHashRequired": true,
    "modelProviderRequired": true,
    "modelIdentifierRequired": true,
    "generationTimestampRequired": true,
    "paragraphSourceMapRequired": true
  },
  "publicationGate": {
    "humanReviewRequired": true,
    "rightsReviewRequired": true,
    "citationValidationRequired": true,
    "originalityValidationRequired": true,
    "atomicPublicationRequired": true,
    "invalidateWhenSourceChanges": true
  },
  "hashAlgorithm": "sha256",
  "hashScope": "canonical-json-without-hash",
