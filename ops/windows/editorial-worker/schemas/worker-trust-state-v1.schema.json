{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubtech.online/schemas/hch.worker-trust-state-v1.schema.json",
  "title": "HCH worker persisted trust anchors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schemaVersion", "rootKeyId", "rootFingerprint", "releaseKeyId",
    "delegationSequence", "delegationHash", "manifestSequence", "manifestHash", "contentContractHash",
    "policyHash", "cryptographicStatus", "freshnessStatus", "freshnessCheckedAt", "verifiedAt"
  ],
  "properties": {
    "schema": { "const": "hch.worker-trust-state/v1" },
    "schemaVersion": { "const": 1 },
    "rootKeyId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "rootFingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9_-]{43}$" },
    "releaseKeyId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "delegationSequence": { "type": "integer", "minimum": 1 },
    "delegationHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestSequence": { "type": "integer", "minimum": 1 },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentContractHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cryptographicStatus": { "const": "verified" },
    "freshnessStatus": { "enum": ["fresh", "freshness-degraded"] },
    "freshnessCheckedAt": { "type": "string", "format": "date-time" },
    "verifiedAt": { "type": "string", "format": "date-time" }
  }
}
