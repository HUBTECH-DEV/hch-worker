{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubtech.online/schemas/hch.worker-runtime-profile-v2.schema.json",
  "title": "HCH editorial worker immutable RuntimeProfile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "engineAdapter",
    "engineAdapterVersion",
    "model",
    "modelDigest",
    "protocol",
    "temperature",
    "contextWindow",
    "maxOutputTokens",
    "policyId",
    "policyVersion",
    "policyHash",
    "promptConfigHash",
    "pipelineVersion",
    "manifestSequence",
    "manifestHash",
    "runtimeProfileHash"
  ],
  "properties": {
    "provider": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,159}$" },
    "engineAdapter": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,159}$" },
    "engineAdapterVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,159}$" },
    "model": { "type": "string", "minLength": 1 },
    "modelDigest": { "type": "string", "pattern": "^(?:sha256:)?[a-fA-F0-9]{64}$" },
    "protocol": { "type": "string", "minLength": 1 },
    "temperature": { "type": "number", "minimum": 0 },
    "contextWindow": { "type": "integer", "minimum": 1 },
    "maxOutputTokens": { "type": "integer", "minimum": 1 },
    "policyId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promptConfigHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pipelineVersion": { "type": "string", "minLength": 1 },
    "manifestSequence": { "type": "integer", "minimum": 1 },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeProfileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
