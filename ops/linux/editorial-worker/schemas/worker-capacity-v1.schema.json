{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubtech.online/schemas/hch.worker-capacity-v1.schema.json",
  "title": "HCH worker capacity grant snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "observedAt",
    "nodeId",
    "workerKeyId",
    "manifestSequence",
    "manifestHash",
    "capacityPolicyHash",
    "algorithmVersion",
    "requestedCapacity",
    "grantedCapacity",
    "capacityClass",
    "reason",
    "grantedUntil",
    "pressure",
    "activeAssignments",
    "availableSlots",
    "source"
  ],
  "properties": {
    "schema": { "const": "hch.worker-capacity/v1" },
    "schemaVersion": { "const": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "nodeId": { "type": "string" },
    "workerKeyId": { "type": "string" },
    "manifestSequence": { "type": "integer", "minimum": 1 },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capacityPolicyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "algorithmVersion": { "const": "hch-adaptive-capacity-v1" },
    "requestedCapacity": { "type": "integer", "minimum": 0, "maximum": 64 },
    "grantedCapacity": { "type": "integer", "minimum": 0, "maximum": 64 },
    "capacityClass": { "enum": ["constrained", "standard", "accelerated"] },
    "reason": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._+\\-]{0,255}$" },
    "grantedUntil": { "type": "string", "format": "date-time" },
    "pressure": { "$ref": "#/$defs/pressure" },
    "activeAssignments": { "type": "integer", "minimum": 0 },
    "availableSlots": { "type": "integer", "minimum": 0, "maximum": 64 },
    "source": { "enum": ["attestation", "execute"] }
  },
  "$defs": {
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "memoryPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "gpuPercent": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
