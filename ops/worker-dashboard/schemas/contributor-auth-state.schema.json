{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hubtech.dev/schemas/hch/worker-dashboard/contributor-auth-state-v1.schema.json",
  "title": "HCH Worker contributor authentication state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "observedAt", "pairing", "eligibility", "consent", "bindingId"],
  "properties": {
    "schema": { "const": "hch.worker-contributor-auth/v1" },
    "schemaVersion": { "const": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pairedAt", "expiresAt"],
      "properties": {
        "status": { "enum": ["paired", "unpaired", "expired", "revoked", "unavailable"] },
        "pairedAt": { "type": ["string", "null"], "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "reasonCodes"],
      "properties": {
        "status": { "enum": ["eligible", "ineligible", "unknown"] },
        "checkedAt": { "type": ["string", "null"], "format": "date-time" },
        "reasonCodes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "acceptedAt"],
      "properties": {
        "status": { "enum": ["accepted", "required", "revoked", "unknown"] },
        "version": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "acceptedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "bindingId": {
      "type": ["string", "null"],
      "pattern": "^hchbind_[A-Za-z0-9_-]{22,86}$"
    }
  }
}
