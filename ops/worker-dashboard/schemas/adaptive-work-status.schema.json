{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hch.local/schemas/worker-dashboard/adaptive-work-v1.json",
  "title": "HCH worker dashboard adaptive work status",
  "type": "object",
  "additionalProperties": false,
  "required": ["available", "workSizing", "activeWork"],
  "properties": {
    "available": { "type": "boolean" },
    "workSizing": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithmVersion", "currentTier", "currentRank", "maxOutputTokens",
            "editorialProfile", "minimumUnit", "downshiftReason", "updatedAt",
            "processingWindowSeconds", "nearWindowSeconds",
            "firstProgressGraceSeconds", "stallAfterSeconds",
            "finalizationGraceSeconds"
          ],
          "properties": {
            "algorithmVersion": { "const": "hch-adaptive-work-v1" },
            "currentTier": { "$ref": "#/$defs/tierId" },
            "currentRank": { "type": "integer", "minimum": 0, "maximum": 15 },
            "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 32768 },
            "editorialProfile": { "$ref": "#/$defs/profileId" },
            "minimumUnit": { "type": "boolean" },
            "downshiftReason": {
              "enum": [
                "attestation-reset", "minimum-unit-window-ignored", "within-window",
                "near-window-downshift", "already-downshifted"
              ]
            },
            "updatedAt": { "$ref": "#/$defs/nullableTimestamp" },
            "processingWindowSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "nearWindowSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "firstProgressGraceSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
            "stallAfterSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
            "finalizationGraceSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
          }
        }
      ]
    },
    "activeWork": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignmentId", "tier", "tierRank", "maxOutputTokens", "minimumUnit",
          "elapsedSeconds", "phase", "lastProgressAt", "progressAgeSeconds",
          "livenessStatus", "livenessReason", "windowState"
        ],
        "properties": {
          "assignmentId": { "$ref": "#/$defs/id" },
          "tier": {
            "anyOf": [{ "$ref": "#/$defs/tierId" }, { "type": "null" }]
          },
          "tierRank": { "type": ["integer", "null"], "minimum": 0, "maximum": 15 },
          "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 32768 },
          "minimumUnit": { "type": ["boolean", "null"] },
          "elapsedSeconds": { "$ref": "#/$defs/counter" },
          "phase": { "enum": ["starting", "responding", "finalizing", null] },
          "lastProgressAt": { "$ref": "#/$defs/nullableTimestamp" },
          "progressAgeSeconds": { "$ref": "#/$defs/counter" },
          "livenessStatus": {
            "enum": [
              "awaiting-first-progress", "progressing", "responding-slowly",
              "finalizing", "stalled"
            ]
          },
          "livenessReason": {
            "enum": [
              "progress-advanced", "awaiting-first-progress",
              "progress-within-stall-grace", "finalization-in-progress",
              "first-progress-grace-exceeded", "progress-stalled",
              "finalization-grace-exceeded"
            ]
          },
          "windowState": {
            "enum": [
              "within-window", "near-window", "over-window",
              "ignored-at-minimum", null
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "counter": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "tierId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
    }
  }
}
